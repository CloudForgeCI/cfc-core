{
  "stackName": "CFCompliance-pcidss-production-fargate",
  "applicationId": "cloudforge-manager",
  "applicationName": "CloudForge Manager",
  "description": "Compliance matrix: PCI-DSS / PRODUCTION / FARGATE on LocalStack",
  "environment": "development",
  "runtime": "FARGATE",
  "securityProfile": "PRODUCTION",
  "topology": "APPLICATION_SERVICE",
  "networkMode": "private-with-nat",
  "region": "us-east-1",
  "authMode": "application-oidc",
  "oidcProvider": "cognito",
  "cognitoAutoProvision": true,
  "cognitoDomainPrefix": "cfc-compliance-pcidss-prod",
  "cognitoMfaEnabled": true,
  "enableSsl": true,
  "provisionDatabase": true,
  "databaseEngine": "postgres",
  "databaseVersion": "15",
  "complianceFrameworks": "PCI-DSS",
  "cpu": 512,
  "memory": 1024,
  "minInstanceCapacity": 1,
  "maxInstanceCapacity": 1,
  "awsConfigEnabled": true,
  "auditManagerEnabled": true
}
