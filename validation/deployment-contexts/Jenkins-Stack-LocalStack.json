{
  "stackName": "Jenkins-Stack",
  "applicationId": "jenkins",
  "applicationName": "Jenkins",
  "description": "LocalStack AWS-parity: domain, SSL, Cognito application-oidc with JCasC wired into Jenkins",
  "environment": "dev",
  "runtime": "FARGATE",
  "securityProfile": "DEV",
  "topology": "APPLICATION_SERVICE",
  "domain": "local.test",
  "subdomain": "jenkins",
  "createZone": true,
  "enableSsl": true,
  "networkMode": "public-no-nat",
  "region": "us-east-1",
  "authMode": "application-oidc",
  "oidcProvider": "cognito",
  "cognitoAutoProvision": true,
  "cognitoDomainPrefix": "jenkins-localstack-auth",
  "cognitoMfaEnabled": false,
  "cognitoCreateGroups": true,
  "cognitoAdminGroupName": "jenkins-Admins",
  "cognitoUserGroupName": "jenkins-Users",
  "cognitoInitialAdminEmail": "admin@local.test",
  "cpu": 1024,
  "memory": 2048,
  "minInstanceCapacity": 1,
  "maxInstanceCapacity": 1,
  "wafEnabled": false,
  "enableMonitoring": true,
  "logRetentionDays": 7
}
