<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.cloudforgeci</groupId>
    <artifactId>cfc-core</artifactId>
    <version>3.2.5-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>cloudforge-core</artifactId>
  <version>3.2.5-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>CloudForge Community Core</name>
  <properties>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <java.version>25</java.version>
  </properties>

  <scm>
    <connection>scm:git:https://github.com/CloudForgeCI/cloudforge-core.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/CloudForgeCI/cloudforge-core.git</developerConnection>
    <url>https://maven.pkg.github.com/CloudForgeCI/cloudforge-core</url>
  </scm>


  <dependencies>
    <!-- Jackson for JSON serialization/deserialization (version from parent BOM) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Jakarta Validation API for validators (version from parent BOM) -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>

    <!-- JUnit 5 for testing (version and scope from parent BOM) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>

    <!-- Hibernate Validator for Jakarta Bean Validation implementation (version and scope from parent BOM) -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
    </dependency>

    <!-- Expression Language implementation required by Hibernate Validator (version and scope from parent BOM) -->
    <dependency>
      <groupId>org.glassfish</groupId>
      <artifactId>jakarta.el</artifactId>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <!-- proc=none for this module's own compile only: BuildModeProcessor is registered via
             this module's own META-INF/services, which javac's default annotation-processing
             auto-discovers on the compile classpath, but during this module's own first build
             from clean, that classpath can't yet contain a compiled BuildModeProcessor.class
             (it's itself one of the sources being compiled right now), so auto-discovery fails
             with "Provider ... not found". Consumers (e.g. cloudforge-manager) don't hit this: by
             the time they compile, cloudforge-core is already a complete, published/installed jar
             with both the compiled processor and the service registration in it, no bootstrapping
             problem. Nothing in this module's own source needs BuildModeProcessor anyway. -->
        <configuration>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>

