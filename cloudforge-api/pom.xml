<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.cloudforgeci</groupId>
    <artifactId>cfc-core</artifactId>
    <version>3.2.25-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>cloudforge-api</artifactId>
  <version>3.2.25-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>CloudForge API</name>

  <scm>
    <connection>scm:git:https://github.com/CloudForgeCI/cfc-core.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/CloudForgeCI/cfc-core.git</developerConnection>
    <url>https://maven.pkg.github.com/CloudForgeCI/cfc-core</url>
  </scm>

  <properties>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <!-- Matches the version cloudforge-localstack/cloudforge-ministack/cloudforge-manager each
         pin independently — no central AWS SDK BOM entry exists in the root pom yet. -->
    <aws.sdk.version>2.25.0</aws.sdk.version>
  </properties>

  <dependencies>
    <!-- Dependency on cloudforge-core for interfaces and enums (version from parent BOM) -->
    <dependency>
      <groupId>com.cloudforgeci</groupId>
      <artifactId>cloudforge-core</artifactId>
    </dependency>
    <!-- AWS CDK dependencies (versions from parent BOM) -->
    <dependency>
      <groupId>software.amazon.awscdk</groupId>
      <artifactId>aws-cdk-lib</artifactId>
    </dependency>
    <dependency>
      <groupId>software.constructs</groupId>
      <artifactId>constructs</artifactId>
    </dependency>
    <!-- CDK Nag for compliance validation (version from parent BOM) -->
    <dependency>
      <groupId>io.github.cdklabs</groupId>
      <artifactId>cdknag</artifactId>
    </dependency>
    <!-- AWS SDK v2 clients for CloudForgeDeployment's direct-to-AWS path (AwsDirectDeployer) —
         real CloudFormation/S3 calls, distinct from the CDK synthesis-time deps above. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>cloudformation</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>
    <!-- Resolves the real (or LocalStack's fixed test) account id once per AwsDirectDeployer, to
         substitute CDK's ${AWS::AccountId} pseudo-parameter token in asset-manifest bucket names —
         see LocalStackCdkAssetPublisher's class javadoc for the bug this closes. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sts</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>
    <!-- AWS Service Catalog client for the deploy:catalog path (ServiceCatalogDeployer) —
         provisioning against pre-published products, the SC_PROVISION capability's actions. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>servicecatalog</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>
    <!-- Resolves the real hosted-zone id for CloudForgeSynthesizer's own seedHostedZoneContext —
         same reasoning as the sts dependency above, one context provider over (DomainFactory's
         HostedZone.fromLookup, not an AZ list). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>route53</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>
    <!-- Local emulator pipelines (api orchestrates; mechanics stay in target modules) -->
    <dependency>
      <groupId>com.cloudforgeci</groupId>
      <artifactId>cloudforge-ministack</artifactId>
    </dependency>
    <dependency>
      <groupId>com.cloudforgeci</groupId>
      <artifactId>cloudforge-localstack</artifactId>
    </dependency>
    <!-- JUnit 5 for testing (version and scope from parent BOM) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Hibernate Validator for Jakarta Bean Validation (version from parent BOM) -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Jakarta EL API (version from parent BOM) -->
    <dependency>
      <groupId>jakarta.el</groupId>
      <artifactId>jakarta.el-api</artifactId>
    </dependency>
    <!-- Expression Language implementation (version from parent BOM) -->
    <dependency>
      <groupId>org.glassfish</groupId>
      <artifactId>jakarta.el</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Jackson YAML for CloudFormation template YAML generation -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The JVM's default thread stack size is too small once enough real CDK synthesis
               (jsii's own background-process bookkeeping, not this codebase's own call depth)
               accumulates across a full, reused-fork test run. Bumped rather than disabling fork
               reuse, to keep the existing (fast) default test-run behavior otherwise. -->
          <!-- @{argLine}, not a literal — jacoco:prepare-agent injects its own javaagent flag
               into that property; overwriting it outright would silently disable coverage
               instrumentation whenever jacoco.skip isn't set. -->
          <argLine>@{argLine} -Xss8m</argLine>
        </configuration>
        <executions>
          <!-- Reconfigures (not duplicates) the plugin's implicit default execution, so this and
               the isolated-fork execution below are the only two that run — excludes
               TruthTableValidationTest, which the second execution handles separately. -->
          <execution>
            <id>default-test</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>**/TruthTableValidationTest.java</exclude>
                <exclude>**/ConfigRulesDeploymentIntegrationTest.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <!-- TruthTableValidationTest is, by a wide margin, the largest single test class in this
               module (100+ parameterized methods, many CSV-driven with 10+ rows each — hundreds of
               full CDK synths in one class), and every synth in this module shares one long-lived
               jsii Node kernel process with no per-test release of live object references. Enough
               accumulated synths degrade that shared kernel until individual jsii round-trips slow
               to a crawl — confirmed via a live `sample` of the stuck Node process mid-run: genuine,
               actively-executing, very deep recursive V8 frames, not a blocked wait. `-Xss8m` above
               didn't help (see TruthTableValidationTest's own
               testSoc2PciDssHipaaGdprFargateAllFrameworks javadoc) because it's not a JVM
               stack-size problem — it's degraded state in the Node-side kernel.

               Isolating this class into its own fork keeps its degradation from ever spreading to
               (or being made worse by) the other ~1000 tests in this module — a real, worthwhile
               improvement on its own. It does NOT fully fix the hang for this class specifically:
               confirmed by reproducing the same genuine-recursion stall inside this isolated fork
               too, with zero other processes competing for CPU, meaning this one class alone has
               enough internal synth volume to degrade a completely fresh kernel on its own. A full
               fix needs either splitting this class into several smaller ones (so no single fork's
               volume reaches the degradation threshold) or a way to reset the jsii kernel mid-run
               (blocked today: `JsiiEngine.reset()` exists but is package-private to
               `software.amazon.jsii`, not callable from this module without reflection). Until then,
               a hang inside this specific execution is a known, pre-existing, accepted risk — not a
               sign anything else broke. -->
          <execution>
            <id>truth-table-isolated-fork</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/TruthTableValidationTest.java</include>
              </includes>
              <reuseForks>false</reuseForks>
              <forkCount>1</forkCount>
              <!-- A hang here is a known, accepted risk (see the comment above) — bound it so CI
                   fails with a clear signal instead of stalling the whole test phase indefinitely. -->
              <forkedProcessTimeoutInSeconds>1800</forkedProcessTimeoutInSeconds>
            </configuration>
          </execution>
          <!-- Same jsii-kernel degradation as TruthTableValidationTest above, different failure
               mode: this class doesn't hang, but intermittently returns an incomplete synth result
               (a resource count of 0 where the code path always produces one) when it runs late in
               the shared default-test fork, after enough prior synths have degraded that fork's
               kernel. A separate fork, not folded into truth-table-isolated-fork's, since that
               class's own synth volume is already enough to degrade a fork on its own — combining
               the two would reintroduce the same risk inside one fork. -->
          <execution>
            <id>config-rules-isolated-fork</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/ConfigRulesDeploymentIntegrationTest.java</include>
              </includes>
              <reuseForks>false</reuseForks>
              <forkCount>1</forkCount>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Diagnostic-only, not wired into any lifecycle phase — run explicitly via
           `mvn org.pitest:pitest-maven:mutationCoverage`. Scoped to core.rules (compliance
           enforcement) rather than the whole module: mutation testing re-runs the test suite
           once per surviving mutant, and this module's full suite is thousands of tests —
           unscoped, a full run would take hours. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.30.0</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.3</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>com.cloudforgeci.api.core.rules.*</param>
          </targetClasses>
          <targetTests>
            <param>com.cloudforgeci.api.core.rules.*</param>
          </targetTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
