# Key Management - Cross-Framework Security Control
#
# CloudFormation Guard rules for cryptographic key management validation
# Applies across all compliance frameworks (HIPAA, PCI-DSS, SOC2, GDPR, ISO 27001, etc.)
#
# CloudForge Core - Multi-Layer Compliance Validation
# Layer 3: Template-Level Policy Enforcement (cfn-guard)

# ============================================================================
# KMS Key Management
# ============================================================================

# Automatic key rotation for customer-managed keys
rule key_management_kms_rotation when
    resourceType == 'AWS::KMS::Key' {

    Properties.EnableKeyRotation == true

    <<
        [Key Management] KMS keys must have automatic rotation enabled.
        CloudForge Mapping: KEY_MANAGEMENT control
    >>
}

# KMS key deletion window (prevent accidental deletion)
rule key_management_kms_deletion_window when
    resourceType == 'AWS::KMS::Key' {

    when Properties.PendingWindowInDays exists {
        Properties.PendingWindowInDays >= 7
    }

    <<
        [Key Management] KMS keys should have deletion window of at least 7 days.
        CloudForge Mapping: KEY_MANAGEMENT control
    >>
}

# ============================================================================
# Encryption at Rest with KMS
# ============================================================================

# S3 bucket encryption with KMS
rule key_management_s3_kms when
    resourceType == 'AWS::S3::Bucket' {

    Properties.BucketEncryption exists
    Properties.BucketEncryption.ServerSideEncryptionConfiguration exists

    Properties.BucketEncryption.ServerSideEncryptionConfiguration[*] {
        ServerSideEncryptionByDefault exists
        ServerSideEncryptionByDefault.SSEAlgorithm in ['AES256', 'aws:kms']
    }

    <<
        [Key Management] S3 buckets must use encryption at rest.
        CloudForge Mapping: ENCRYPTION_AT_REST control
    >>
}

# RDS encryption
rule key_management_rds_encryption when
    resourceType == 'AWS::RDS::DBInstance' {

    Properties.StorageEncrypted == true

    <<
        [Key Management] RDS instances must use encrypted storage.
        CloudForge Mapping: ENCRYPTION_AT_REST control
    >>
}

# EBS volume encryption
rule key_management_ebs_encryption when
    resourceType == 'AWS::EC2::Volume' {

    Properties.Encrypted == true

    <<
        [Key Management] EBS volumes must be encrypted.
        CloudForge Mapping: ENCRYPTION_AT_REST control
    >>
}

# EFS encryption
rule key_management_efs_encryption when
    resourceType == 'AWS::EFS::FileSystem' {

    Properties.Encrypted == true

    <<
        [Key Management] EFS file systems must be encrypted.
        CloudForge Mapping: ENCRYPTION_AT_REST control
    >>
}

# DynamoDB encryption
rule key_management_dynamodb_encryption when
    resourceType == 'AWS::DynamoDB::Table' {

    when Properties.SSESpecification exists {
        Properties.SSESpecification.SSEEnabled == true
    }

    <<
        [Key Management] DynamoDB tables should use encryption at rest.
        CloudForge Mapping: ENCRYPTION_AT_REST control
    >>
}

# ============================================================================
# Encryption in Transit
# ============================================================================

# CloudFront TLS version
rule key_management_cloudfront_tls when
    resourceType == 'AWS::CloudFront::Distribution' {

    Properties.DistributionConfig.ViewerCertificate exists
    Properties.DistributionConfig.ViewerCertificate.MinimumProtocolVersion in ['TLSv1.2_2021', 'TLSv1.2_2019', 'TLSv1.2_2018']

    <<
        [Key Management] CloudFront distributions must use TLS 1.2+.
        CloudForge Mapping: ENCRYPTION_IN_TRANSIT control
    >>
}

# ALB HTTPS listeners
rule key_management_alb_https when
    resourceType == 'AWS::ElasticLoadBalancingV2::Listener' {

    Properties.Protocol in ['HTTPS', 'TLS']
    Properties.Certificates exists

    <<
        [Key Management] ALB listeners must use HTTPS/TLS.
        CloudForge Mapping: ENCRYPTION_IN_TRANSIT control
    >>
}

# ============================================================================
# Secrets Management
# ============================================================================

# Secrets Manager rotation
rule key_management_secrets_rotation when
    resourceType == 'AWS::SecretsManager::Secret' {

    when Properties.RotationSchedule exists {
        Properties.RotationSchedule.RotationRules.AutomaticallyAfterDays exists
        Properties.RotationSchedule.RotationRules.AutomaticallyAfterDays <= 90
    }

    <<
        [Key Management] Secrets Manager secrets should have automatic rotation configured.
        CloudForge Mapping: KEY_MANAGEMENT control
    >>
}

# ============================================================================
# CloudTrail Log Encryption
# ============================================================================

# CloudTrail log encryption with KMS
rule key_management_cloudtrail_kms when
    resourceType == 'AWS::CloudTrail::Trail' {

    Properties.KMSKeyId exists

    <<
        [Key Management] CloudTrail logs should be encrypted with KMS.
        CloudForge Mapping: ENCRYPTION_AT_REST control
    >>
}
