# FedRAMP - NIST 800-53 Rev 5 Control Baseline
#
# CloudFormation Guard rules for FedRAMP compliance validation
# Based on NIST SP 800-53 Revision 5 control families
#
# CloudForge Core - Multi-Layer Compliance Validation
# Layer 3: Template-Level Policy Enforcement (cfn-guard)
#
# Mirrors the controls FedRampRules.java already checks at Layer 2 (SecurityProfileConfiguration
# booleans), re-expressed as template-level assertions against the synthesized CloudFormation --
# the same defense-in-depth relationship every other framework's Layer 3 file has with its own
# signals. Controls already covered by an always-load file (key-management.guard, iam-security.guard,
# compute-security.guard, database-security.guard, elb-security.guard, cdn-api-security.guard,
# lambda-security.guard, advanced-monitoring.guard, incident-response.guard, threat-protection.guard)
# are not restated here -- see the per-section notes below for which family that closes.
#
# CM-2 (baseline configuration) has no template-visible signal -- it's satisfied structurally by
# this codebase's infrastructure-as-code deployment model, not something to assert against a single
# resource -- and is not checked at any layer. AC-6 (least privilege), IA-5 (authenticator
# management), SC-12 (cryptographic key establishment), and SC-13 (cryptographic protection) are
# all Layer 2 checks now (FedRampRules.validateAccessControl/validateIdentificationAuthentication/
# validateSystemCommunications); they have no template-visible signal cfn-guard could assert on
# independently, so Layer 3 doesn't restate them.

let flow_logs = Resources.*[ Type == 'AWS::EC2::FlowLog' ]
let security_groups = Resources.*[ Type == 'AWS::EC2::SecurityGroup' ]
let cloudtrail_trails = Resources.*[ Type == 'AWS::CloudTrail::Trail' ]
let s3_buckets = Resources.*[ Type == 'AWS::S3::Bucket' ]
let log_groups = Resources.*[ Type == 'AWS::Logs::LogGroup' ]
let alb_loadbalancers = Resources.*[ Type == 'AWS::ElasticLoadBalancingV2::LoadBalancer' ]
let rds_instances = Resources.*[ Type == 'AWS::RDS::DBInstance' ]
let cognito_pools = Resources.*[ Type == 'AWS::Cognito::UserPool' ]
let alb_https_listeners = Resources.*[ Type == 'AWS::ElasticLoadBalancingV2::Listener' Properties.Port == 443 ]
let alb_listeners = Resources.*[ Type == 'AWS::ElasticLoadBalancingV2::Listener' ]
let ebs_volumes = Resources.*[ Type == 'AWS::EC2::Volume' ]
let efs_filesystems = Resources.*[ Type == 'AWS::EFS::FileSystem' ]

# ============================================================================
# AC - Access Control
# ============================================================================

# AC-4 - Information Flow Enforcement / SI-4(4) - Inbound/Outbound Communications Traffic
# CloudForge Mapping: NETWORK_MONITORING control
rule fedramp_flow_logs_enabled when %flow_logs !empty {

    %flow_logs.Properties.ResourceType == 'VPC' <<[FedRAMP AC-4] VPC Flow Logs must target VPC>>
    %flow_logs.Properties.TrafficType == 'ALL' <<[FedRAMP AC-4] VPC Flow Logs must capture ALL traffic>>
}

# AC-17 - Remote Access
# CloudForge Mapping: NETWORK_SEGMENTATION control
rule fedramp_security_groups_restricted when %security_groups !empty {

    when %security_groups.Properties.SecurityGroupIngress exists {
        %security_groups.Properties.SecurityGroupIngress[*] {
            when CidrIp exists {
                CidrIp != '0.0.0.0/0' <<[FedRAMP AC-17] Security groups must not allow unrestricted access>>
            }
            when CidrIpv6 exists {
                CidrIpv6 != '::/0' <<[FedRAMP AC-17] Security groups must not allow unrestricted IPv6 access>>
            }
        }
    }
}

# ============================================================================
# AU - Audit and Accountability
# ============================================================================

# AU-2 - Event Logging / AU-3 - Content of Audit Records / SI-7 - Software, Firmware, Information Integrity
# CloudForge Mapping: AUDIT_LOGGING control
rule fedramp_cloudtrail_enabled when %cloudtrail_trails !empty {

    %cloudtrail_trails.Properties.IsLogging == true <<[FedRAMP AU-2] CloudTrail must be enabled>>
    %cloudtrail_trails.Properties.EnableLogFileValidation == true <<[FedRAMP AU-3/SI-7] CloudTrail must enable log file validation>>
}

# AU-9 - Protection of Audit Information
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule fedramp_cloudtrail_kms_encryption when %cloudtrail_trails !empty {

    %cloudtrail_trails.Properties.KMSKeyId exists <<[FedRAMP AU-9] CloudTrail logs must be encrypted with KMS>>
}

# AU-9 - Protection of Audit Information (immutability, where Object Lock is declared)
# CloudForge Mapping: S3_OBJECT_LOCK control
rule fedramp_s3_object_lock when %s3_buckets !empty {

    when %s3_buckets.Properties.ObjectLockEnabled exists {
        %s3_buckets.Properties.ObjectLockEnabled == true <<[FedRAMP AU-9] Object Lock must be enabled where declared>>
        %s3_buckets.Properties.ObjectLockConfiguration exists <<[FedRAMP AU-9] Object Lock configuration must be set>>
    }
}

# AU-11 - Audit Record Retention (3 years -- stricter than the 90-day baseline other frameworks use)
# CloudForge Mapping: LOG_RETENTION control
rule fedramp_log_retention_3yr when %log_groups !empty {

    # Absent RetentionInDays means the log group never expires (RetentionDays.INFINITE), which
    # satisfies AU-11 -- FedRampRules.isRetentionSufficient already accepts it as compliant.
    when %log_groups.Properties.RetentionInDays exists {
        %log_groups.Properties.RetentionInDays >= 1095 <<[FedRAMP AU-11] CloudWatch logs must retain for at least 3 years (1095 days)>>
    }
}

# AU-12 - Audit Record Generation (ALB access logs)
# CloudForge Mapping: AUDIT_LOGGING control
rule fedramp_alb_access_logging when %alb_loadbalancers !empty {

    %alb_loadbalancers.Properties.LoadBalancerAttributes[*] {
        when Key == 'access_logs.s3.enabled' {
            Value == 'true' <<[FedRAMP AU-12] ALB access logging must be enabled>>
        }
    }
}

# ============================================================================
# CP - Contingency Planning
# ============================================================================

# CP-9 - System Backup
# CloudForge Mapping: BACKUP_RECOVERY control
rule fedramp_rds_backup when %rds_instances !empty {

    %rds_instances.Properties.BackupRetentionPeriod exists <<[FedRAMP CP-9] RDS must have backup retention configured>>
    %rds_instances.Properties.BackupRetentionPeriod >= 7 <<[FedRAMP CP-9] RDS backups must be retained for at least 7 days>>
}

# CP-10 - System Recovery and Reconstitution
# CloudForge Mapping: DATABASE_MULTI_AZ control
rule fedramp_rds_multi_az when %rds_instances !empty {

    %rds_instances.Properties.MultiAZ == true <<[FedRAMP CP-10] RDS instances must use Multi-AZ for high availability>>
}

# ============================================================================
# IA - Identification and Authentication
# ============================================================================

# IA-2(1) - Multi-Factor Authentication
# CloudForge Mapping: AUTHENTICATION control
rule fedramp_cognito_mfa when %cognito_pools !empty {

    %cognito_pools.Properties.MfaConfiguration == 'ON' <<[FedRAMP IA-2(1)] Cognito user pools must require MFA>>
}

# IA-5(1) - Password-Based Authentication
# CloudForge Mapping: CREDENTIAL_ROTATION control
rule fedramp_cognito_password_length when %cognito_pools !empty {

    %cognito_pools.Properties.Policies.PasswordPolicy.MinimumLength >= 12 <<[FedRAMP IA-5(1)] Cognito password policy must require at least 12 characters>>
}

# ============================================================================
# SC - System and Communications Protection
# ============================================================================

# SC-8 - Transmission Confidentiality and Integrity / MP-5 - Media Transport
# CloudForge Mapping: ENCRYPTION_IN_TRANSIT control
rule fedramp_alb_https when %alb_https_listeners !empty {

    %alb_https_listeners.Properties.Protocol in ['HTTPS', 'TLS'] <<[FedRAMP SC-8] ALB listeners must use HTTPS/TLS>>
    %alb_https_listeners.Properties.Certificates exists <<[FedRAMP SC-8] ALB listeners must have certificates configured>>
}

# SC-8(1) - Cryptographic Protection (HTTP listeners, when present, must redirect to HTTPS)
# CloudForge Mapping: HTTPS_STRICT control
rule fedramp_http_listener_redirects when %alb_listeners !empty {

    when %alb_listeners.Properties.Protocol == 'HTTP' {
        some %alb_listeners.Properties.DefaultActions[*] {
            Type == 'redirect' <<[FedRAMP SC-8(1)] HTTP listeners must redirect to HTTPS>>
        }
    }
}

# SC-28 - Protection of Information at Rest
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule fedramp_ebs_encryption when %ebs_volumes !empty {

    %ebs_volumes.Properties.Encrypted == true <<[FedRAMP SC-28] EBS volumes must be encrypted>>
}

# CloudForge Mapping: ENCRYPTION_AT_REST control
rule fedramp_efs_encryption when %efs_filesystems !empty {

    %efs_filesystems.Properties.Encrypted == true <<[FedRAMP SC-28] EFS file systems must be encrypted>>
}

# CloudForge Mapping: ENCRYPTION_AT_REST control
rule fedramp_rds_encryption when %rds_instances !empty {

    %rds_instances.Properties.StorageEncrypted == true <<[FedRAMP SC-28] RDS instances must use encrypted storage>>
}
