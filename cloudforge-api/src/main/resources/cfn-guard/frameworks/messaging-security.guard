# Messaging Security - Cross-Framework Security Control
#
# CloudFormation Guard rules for SQS, SNS, Secrets Manager, and messaging service validation
# Applies across all compliance frameworks (HIPAA, PCI-DSS, SOC2, GDPR, ISO 27001, etc.)
#
# CloudForge Core - Multi-Layer Compliance Validation
# Layer 3: Template-Level Policy Enforcement (cfn-guard)


let sqs_queue = Resources.*[ Type == 'AWS::SQS::Queue' ]
let sns_topic = Resources.*[ Type == 'AWS::SNS::Topic' ]
let sns_topicpolicy = Resources.*[ Type == 'AWS::SNS::TopicPolicy' ]
let secretsmanager_secret = Resources.*[ Type == 'AWS::SecretsManager::Secret' ]
let secretsmanager_rotationschedule = Resources.*[ Type == 'AWS::SecretsManager::RotationSchedule' ]
let events_rule = Resources.*[ Type == 'AWS::Events::Rule' ]
let kinesis_stream = Resources.*[ Type == 'AWS::Kinesis::Stream' ]
let kinesisfirehose_deliverystream = Resources.*[ Type == 'AWS::KinesisFirehose::DeliveryStream' ]
# ============================================================================
# SQS Queue Security
# ============================================================================

# SQS encryption at rest
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule messaging_security_sqs_encryption when %sqs_queue !empty {

    %sqs_queue.Properties.KmsMasterKeyId exists <<[Messaging Security] SQS queues must use KMS encryption at rest>>
}

# SQS SSE-SQS encryption alternative
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule messaging_security_sqs_sse when %sqs_queue !empty {

    %sqs_queue.Properties.KmsMasterKeyId exists OR Properties.SqsManagedSseEnabled == true <<[Messaging Security] SQS queues must enable server-side encryption>>
}

# SQS dead letter queue
# CloudForge Mapping: ERROR_HANDLING control
rule messaging_security_sqs_dlq when %sqs_queue !empty {

    when Properties.RedrivePolicy exists {
        %sqs_queue.Properties.RedrivePolicy.deadLetterTargetArn exists <<[Messaging Security] SQS dead letter queue must specify target ARN>>
        %sqs_queue.Properties.RedrivePolicy.maxReceiveCount exists <<[Messaging Security] SQS dead letter queue must specify max receive count>>
    }
}

# SQS visibility timeout
# CloudForge Mapping: CONFIGURATION_MANAGEMENT control
rule messaging_security_sqs_visibility_timeout when %sqs_queue !empty {

    %sqs_queue.Properties.VisibilityTimeout exists <<[Messaging Security] SQS queues should configure visibility timeout>>
    %sqs_queue.Properties.VisibilityTimeout >= 30 <<[Messaging Security] SQS visibility timeout should be at least 30 seconds>>
}

# ============================================================================
# SNS Topic Security
# ============================================================================

# SNS encryption at rest
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule messaging_security_sns_encryption when %sns_topic !empty {

    %sns_topic.Properties.KmsMasterKeyId exists <<[Messaging Security] SNS topics must use KMS encryption at rest>>
}

# SNS topic policy restriction
# CloudForge Mapping: ACCESS_CONTROL control
rule messaging_security_sns_policy_restriction when %sns_topicpolicy !empty {

    when Properties.PolicyDocument exists {
        when Properties.PolicyDocument.Statement exists {
            %sns_topicpolicy.Properties.PolicyDocument.Statement[*] {
                when Effect == 'Allow' {
                    when Principal exists {
                        Principal != '*' <<[Messaging Security] SNS topic policies must not allow public access (Principal: "*")>>
                        when Principal.AWS exists {
                            Principal.AWS != '*' <<[Messaging Security] SNS topic policies must not allow public access (Principal.AWS: "*")>>
                        }
                    }
                }
            }
        }
    }
}

# ============================================================================
# Secrets Manager Security
# ============================================================================

# Secrets Manager cross-region replication
# CloudForge Mapping: HIGH_AVAILABILITY control
rule messaging_security_secretsmanager_replication when %secretsmanager_secret !empty {

    %secretsmanager_secret.Properties.ReplicaRegions exists <<[Messaging Security] Secrets Manager secrets should configure cross-region replication>>
}

# Secrets Manager automatic rotation
# CloudForge Mapping: KEY_MANAGEMENT control
rule messaging_security_secretsmanager_rotation when %secretsmanager_rotationschedule !empty {

    %secretsmanager_rotationschedule.Properties.RotationRules exists <<[Messaging Security] Secrets Manager secrets should have rotation rules>>
    %secretsmanager_rotationschedule.Properties.RotationRules.AutomaticallyAfterDays exists <<[Messaging Security] Secrets Manager rotation must specify rotation interval>>
    %secretsmanager_rotationschedule.Properties.RotationRules.AutomaticallyAfterDays <= 90 <<[Messaging Security] Secrets Manager secrets should rotate within 90 days>>
}

# Secrets Manager KMS encryption
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule messaging_security_secretsmanager_kms when %secretsmanager_secret !empty {

    %secretsmanager_secret.Properties.KmsKeyId exists <<[Messaging Security] Secrets Manager secrets must use customer-managed KMS keys>>
}

# ============================================================================
# EventBridge Security
# ============================================================================

# EventBridge rule with target
# CloudForge Mapping: CONFIGURATION_MANAGEMENT control
rule messaging_security_eventbridge_target when %events_rule !empty {

    %events_rule.Properties.Targets exists <<[Messaging Security] EventBridge rules must have targets configured>>
    %events_rule.Properties.Targets not empty <<[Messaging Security] EventBridge rules must have at least one target>>
}

# EventBridge rule with DLQ
# CloudForge Mapping: ERROR_HANDLING control
rule messaging_security_eventbridge_dlq when %events_rule !empty {

    when Properties.Targets exists {
        %events_rule.Properties.Targets[*] {
            when DeadLetterConfig exists {
                DeadLetterConfig.Arn exists <<[Messaging Security] EventBridge target dead letter config must specify ARN>>
            }
        }
    }
}

# ============================================================================
# Kinesis Stream Security
# ============================================================================

# Kinesis encryption at rest
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule messaging_security_kinesis_encryption when %kinesis_stream !empty {

    %kinesis_stream.Properties.StreamEncryption exists <<[Messaging Security] Kinesis streams must have encryption configured>>
    %kinesis_stream.Properties.StreamEncryption.EncryptionType exists <<[Messaging Security] Must specify encryption type>>
    %kinesis_stream.Properties.StreamEncryption.EncryptionType == 'KMS' <<[Messaging Security] Kinesis streams must use KMS encryption>>
}

# Kinesis enhanced monitoring
# CloudForge Mapping: MONITORING control
rule messaging_security_kinesis_monitoring when %kinesis_stream !empty {

    %kinesis_stream.Properties.StreamModeDetails exists <<[Messaging Security] Kinesis streams should configure stream mode>>
}

# ============================================================================
# Kinesis Firehose Security
# ============================================================================

# Firehose encryption
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule messaging_security_firehose_encryption when %kinesisfirehose_deliverystream !empty {

    %kinesisfirehose_deliverystream.Properties.DeliveryStreamEncryptionConfigurationInput exists <<[Messaging Security] Kinesis Firehose must configure encryption>>
    %kinesisfirehose_deliverystream.Properties.DeliveryStreamEncryptionConfigurationInput.KeyType exists <<[Messaging Security] Must specify encryption key type>>
    %kinesisfirehose_deliverystream.Properties.DeliveryStreamEncryptionConfigurationInput.KeyType in ['AWS_OWNED_CMK', 'CUSTOMER_MANAGED_CMK'] <<[Messaging Security] Kinesis Firehose delivery streams must use encryption>>
}

# Firehose S3 destination encryption
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule messaging_security_firehose_s3_encryption when %kinesisfirehose_deliverystream !empty {

    when Properties.S3DestinationConfiguration exists {
        %kinesisfirehose_deliverystream.Properties.S3DestinationConfiguration.EncryptionConfiguration exists <<[Messaging Security] Kinesis Firehose S3 destination must use encryption>>
    }

    when Properties.ExtendedS3DestinationConfiguration exists {
        %kinesisfirehose_deliverystream.Properties.ExtendedS3DestinationConfiguration.EncryptionConfiguration exists <<[Messaging Security] Kinesis Firehose Extended S3 destination must use encryption>>
    }
}
