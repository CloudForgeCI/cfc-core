# Lambda Security - Cross-Framework Security Control
#
# CloudFormation Guard rules for Lambda function validation
# Applies across all compliance frameworks (HIPAA, PCI-DSS, SOC2, GDPR, ISO 27001, etc.)
#
# CloudForge Core - Multi-Layer Compliance Validation
# Layer 3: Template-Level Policy Enforcement (cfn-guard)


let lambda_function = Resources.*[ Type == 'AWS::Lambda::Function' ]
let lambda_alias = Resources.*[ Type == 'AWS::Lambda::Alias' ]
let lambda_permission = Resources.*[ Type == 'AWS::Lambda::Permission' ]
# ============================================================================
# Lambda Runtime Security
# ============================================================================

# Detect obsolete/deprecated runtimes
# CloudForge Mapping: LAMBDA_SECURITY control
rule lambda_security_obsolete_runtime when %lambda_function !empty {

    when Properties.Runtime exists {
        %lambda_function.Properties.Runtime not in [
            'python2.7',
            'python3.6',
            'nodejs6.10',
            'nodejs8.10',
            'nodejs10.x',
            'dotnetcore2.0',
            'dotnetcore2.1',
            'ruby2.5'
        ] <<[Lambda Security] Lambda functions must not use deprecated runtimes>>
    }
}

# ============================================================================
# Lambda Network Security
# ============================================================================

# Lambda VPC configuration
# CloudForge Mapping: LAMBDA_SECURITY control
rule lambda_security_in_vpc when %lambda_function !empty {

    %lambda_function.Properties.VpcConfig exists <<[Lambda Security] Lambda functions should be deployed in a VPC>>
    %lambda_function.Properties.VpcConfig.SubnetIds exists <<[Lambda Security] Lambda VPC config must specify SubnetIds>>
    %lambda_function.Properties.VpcConfig.SecurityGroupIds exists <<[Lambda Security] Lambda VPC config must specify SecurityGroupIds>>
}

# ============================================================================
# Lambda Error Handling
# ============================================================================

# Lambda dead letter queue
# CloudForge Mapping: ERROR_HANDLING control
rule lambda_security_dead_letter_queue when %lambda_function !empty {

    %lambda_function.Properties.DeadLetterConfig exists <<[Lambda Security] Lambda functions must have dead letter queues configured>>
    %lambda_function.Properties.DeadLetterConfig.TargetArn exists <<[Lambda Security] Lambda DeadLetterConfig must specify TargetArn>>
}

# ============================================================================
# Lambda Code Security
# ============================================================================

# Lambda code signing configuration
# CloudForge Mapping: LAMBDA_SECURITY control
rule lambda_security_code_signing when %lambda_function !empty {

    %lambda_function.Properties.CodeSigningConfigArn exists <<[Lambda Security] Lambda functions must use code signing>>
}

# ============================================================================
# Lambda Resource Management
# ============================================================================

# Lambda concurrent execution limit
# CloudForge Mapping: LAMBDA_SECURITY control
rule lambda_security_concurrent_execution_limit when %lambda_function !empty {

    %lambda_function.Properties.ReservedConcurrentExecutions exists <<[Lambda Security] Lambda functions should have reserved concurrent executions configured>>
}

# Lambda memory configuration (reasonable limits)
# CloudForge Mapping: LAMBDA_SECURITY control
rule lambda_security_memory_configured when %lambda_function !empty {

    %lambda_function.Properties.MemorySize exists <<[Lambda Security] Lambda functions should have MemorySize configured>>
    %lambda_function.Properties.MemorySize >= 128 <<[Lambda Security] Lambda MemorySize must be at least 128 MB>>
    %lambda_function.Properties.MemorySize <= 10240 <<[Lambda Security] Lambda MemorySize must not exceed 10240 MB>>
}

# Lambda timeout configuration
# CloudForge Mapping: LAMBDA_SECURITY control
rule lambda_security_timeout_configured when %lambda_function !empty {

    %lambda_function.Properties.Timeout exists <<[Lambda Security] Lambda functions should have Timeout configured>>
    %lambda_function.Properties.Timeout >= 1 <<[Lambda Security] Lambda Timeout must be at least 1 second>>
    %lambda_function.Properties.Timeout <= 900 <<[Lambda Security] Lambda Timeout must not exceed 900 seconds>>
}

# ============================================================================
# Lambda Monitoring
# ============================================================================

# Lambda X-Ray tracing
# CloudForge Mapping: MONITORING control
rule lambda_security_xray_tracing when %lambda_function !empty {

    %lambda_function.Properties.TracingConfig exists <<[Lambda Security] Lambda functions must enable X-Ray tracing>>
    %lambda_function.Properties.TracingConfig.Mode exists <<[Lambda Security] Must specify tracing mode>>
    %lambda_function.Properties.TracingConfig.Mode in ['Active', 'PassThrough'] <<[Lambda Security] Lambda TracingConfig Mode must be Active or PassThrough>>
}

# ============================================================================
# Lambda Environment Security
# ============================================================================

# Lambda environment variables encryption
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule lambda_security_env_encryption when %lambda_function !empty {

    when Properties.Environment exists {
        when Properties.Environment.Variables exists {
            %lambda_function.Properties.KmsKeyArn exists <<[Lambda Security] Lambda functions with environment variables must use KMS encryption>>
        }
    }
}

# ============================================================================
# Lambda Version and Alias
# ============================================================================

# Lambda function versioning (via alias or version)
# CloudForge Mapping: CONFIGURATION_MANAGEMENT control
rule lambda_security_versioning when %lambda_alias !empty {

    %lambda_alias.Properties.FunctionVersion exists <<[Lambda Security] Lambda aliases should reference specific versions>>
}

# Lambda provisioned concurrency (for production)
# CloudForge Mapping: PERFORMANCE control
rule lambda_security_provisioned_concurrency when %lambda_alias !empty {

    when Properties.ProvisionedConcurrencyConfig exists {
        %lambda_alias.Properties.ProvisionedConcurrencyConfig.ProvisionedConcurrentExecutions >= 1 <<[Lambda Security] Lambda provisioned concurrency must be at least 1>>
    }
}

# ============================================================================
# Lambda Permission Security
# ============================================================================

# Lambda resource-based policy restrictions
# CloudForge Mapping: ACCESS_CONTROL control
rule lambda_security_permission_principal when %lambda_permission !empty {

    %lambda_permission.Properties.Principal != '*' <<[Lambda Security] Lambda permissions must not allow public invocation (Principal: "*")>>
}

# Lambda permission with source restriction
# CloudForge Mapping: ACCESS_CONTROL control
rule lambda_security_permission_source when %lambda_permission !empty {

    %lambda_permission.Properties.SourceArn exists OR Properties.SourceAccount exists <<[Lambda Security] Lambda permissions should specify SourceArn or SourceAccount>>
}
