# Advanced Monitoring - Cross-Framework Security Control
#
# CloudFormation Guard rules for monitoring validation
# Applies across all compliance frameworks (HIPAA, PCI-DSS, SOC2, GDPR, ISO 27001, etc.)
#
# CloudForge Core - Multi-Layer Compliance Validation
# Layer 3: Template-Level Policy Enforcement (cfn-guard)


let logs_loggroup = Resources.*[ Type == 'AWS::Logs::LogGroup' ]
let cloudwatch_alarm = Resources.*[ Type == 'AWS::CloudWatch::Alarm' ]
let cloudtrail_trail = Resources.*[ Type == 'AWS::CloudTrail::Trail' ]
let ec2_flowlog = Resources.*[ Type == 'AWS::EC2::FlowLog' ]
let rds_dbinstance = Resources.*[ Type == 'AWS::RDS::DBInstance' ]
let lambda_function = Resources.*[ Type == 'AWS::Lambda::Function' ]
let s3_bucket = Resources.*[ Type == 'AWS::S3::Bucket' ]
let elasticloadbalancingv2_loadbalancer = Resources.*[ Type == 'AWS::ElasticLoadBalancingV2::LoadBalancer' ]
let apigateway_stage = Resources.*[ Type == 'AWS::ApiGateway::Stage' ]
let config_configurationrecorder = Resources.*[ Type == 'AWS::Config::ConfigurationRecorder' ]
let config_deliverychannel = Resources.*[ Type == 'AWS::Config::DeliveryChannel' ]
let guardduty_detector = Resources.*[ Type == 'AWS::GuardDuty::Detector' ]
let cloudfront_distribution = Resources.*[ Type == 'AWS::CloudFront::Distribution' ]
let redshift_cluster = Resources.*[ Type == 'AWS::Redshift::Cluster' ]
let ecs_taskdefinition = Resources.*[ Type == 'AWS::ECS::TaskDefinition' ]
let xray_samplingrule = Resources.*[ Type == 'AWS::XRay::SamplingRule' ]
let cloudwatch_compositealarm = Resources.*[ Type == 'AWS::CloudWatch::CompositeAlarm' ]
let logs_metricfilter = Resources.*[ Type == 'AWS::Logs::MetricFilter' ]
let cloudwatch_dashboard = Resources.*[ Type == 'AWS::CloudWatch::Dashboard' ]
# ============================================================================
# CloudWatch Logs
# ============================================================================

# Log group retention
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_cloudwatch_retention when %logs_loggroup !empty {

    %logs_loggroup.Properties.RetentionInDays exists <<[Advanced Monitoring] CloudWatch log groups must have retention configured>>
    %logs_loggroup.Properties.RetentionInDays >= 90 <<[Advanced Monitoring] CloudWatch logs must retain for at least 90 days>>
}

# Log group encryption
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule advanced_monitoring_log_encryption when %logs_loggroup !empty {

    %logs_loggroup.Properties.KmsKeyId exists <<[Advanced Monitoring] CloudWatch log groups must be encrypted with KMS>>
}

# ============================================================================
# CloudWatch Alarms
# ============================================================================

# Alarms with actions enabled
# CloudForge Mapping: MONITORING control
rule advanced_monitoring_alarm_actions when %cloudwatch_alarm !empty {

    %cloudwatch_alarm.Properties.ActionsEnabled == true <<[Advanced Monitoring] CloudWatch alarms must have actions enabled>>
    %cloudwatch_alarm.Properties.AlarmActions exists <<[Advanced Monitoring] CloudWatch alarms must have alarm actions configured>>
}

# ============================================================================
# CloudTrail Logging
# ============================================================================

# CloudTrail enabled
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_cloudtrail_enabled when %cloudtrail_trail !empty {

    %cloudtrail_trail.Properties.IsLogging == true <<[Advanced Monitoring] CloudTrail must be enabled>>
    %cloudtrail_trail.Properties.EnableLogFileValidation == true <<[Advanced Monitoring] CloudTrail must enable log file validation>>
}

# CloudTrail multi-region
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_cloudtrail_multiregion when %cloudtrail_trail !empty {

    %cloudtrail_trail.Properties.IsMultiRegionTrail == true <<[Advanced Monitoring] CloudTrail should be multi-region>>
    %cloudtrail_trail.Properties.IncludeGlobalServiceEvents == true <<[Advanced Monitoring] CloudTrail should include global events>>
}

# CloudTrail CloudWatch logs integration
# CloudForge Mapping: MONITORING control
rule advanced_monitoring_cloudtrail_cloudwatch when %cloudtrail_trail !empty {

    %cloudtrail_trail.Properties.CloudWatchLogsLogGroupArn exists <<[Advanced Monitoring] CloudTrail should send logs to CloudWatch>>
}

# ============================================================================
# VPC Flow Logs
# ============================================================================

# VPC Flow Logs enabled
# CloudForge Mapping: NETWORK_MONITORING control
rule advanced_monitoring_vpc_flow_logs when %ec2_flowlog !empty {

    %ec2_flowlog.Properties.ResourceType == 'VPC' <<[Advanced Monitoring] VPC Flow Logs must target VPC>>
    %ec2_flowlog.Properties.TrafficType == 'ALL' <<[Advanced Monitoring] VPC Flow Logs must capture ALL traffic>>
}

# ============================================================================
# RDS Enhanced Monitoring
# ============================================================================

# RDS enhanced monitoring
# CloudForge Mapping: MONITORING control
rule advanced_monitoring_rds_enhanced when %rds_dbinstance !empty {

    %rds_dbinstance.Properties.MonitoringInterval exists <<[Advanced Monitoring] RDS must have monitoring interval configured>>
    %rds_dbinstance.Properties.MonitoringInterval in [1, 5, 10, 15, 30, 60] <<[Advanced Monitoring] RDS monitoring interval must be valid>>
}

# RDS CloudWatch log exports
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_rds_logs when %rds_dbinstance !empty {

    %rds_dbinstance.Properties.EnableCloudwatchLogsExports exists <<[Advanced Monitoring] RDS should export logs to CloudWatch>>
    %rds_dbinstance.Properties.EnableCloudwatchLogsExports not empty <<[Advanced Monitoring] RDS must have at least one log export configured>>
}

# RDS performance insights
# CloudForge Mapping: MONITORING control
rule advanced_monitoring_rds_performance_insights when %rds_dbinstance !empty {

    when Properties.EnablePerformanceInsights exists {
        %rds_dbinstance.Properties.EnablePerformanceInsights == true <<[Advanced Monitoring] RDS Performance Insights should be enabled>>
    }
}

# ============================================================================
# Lambda Function Monitoring
# ============================================================================

# Lambda tracing (X-Ray)
# CloudForge Mapping: MONITORING control
rule advanced_monitoring_lambda_tracing when %lambda_function !empty {

    %lambda_function.Properties.TracingConfig exists <<[Advanced Monitoring] Lambda functions must enable X-Ray tracing>>
    %lambda_function.Properties.TracingConfig.Mode exists <<[Advanced Monitoring] Must specify tracing mode>>
    %lambda_function.Properties.TracingConfig.Mode in ['Active', 'PassThrough'] <<[Advanced Monitoring] Lambda tracing mode must be Active or PassThrough>>
}

# Lambda dead letter queue
# CloudForge Mapping: ERROR_HANDLING control
rule advanced_monitoring_lambda_dlq when %lambda_function !empty {

    %lambda_function.Properties.DeadLetterConfig exists <<[Advanced Monitoring] Lambda functions must have dead letter queues configured>>
    %lambda_function.Properties.DeadLetterConfig.TargetArn exists <<[Advanced Monitoring] Lambda DLQ must specify target ARN>>
}

# ============================================================================
# S3 Bucket Logging
# ============================================================================

# S3 access logging
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_s3_logging when %s3_bucket !empty {

    %s3_bucket.Properties.LoggingConfiguration exists <<[Advanced Monitoring] S3 buckets must have logging configured>>
    %s3_bucket.Properties.LoggingConfiguration.DestinationBucketName exists <<[Advanced Monitoring] S3 logging must specify destination bucket>>
}

# ============================================================================
# ALB Access Logs
# ============================================================================

# ALB access logging
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_alb_logging when %elasticloadbalancingv2_loadbalancer !empty {

    %elasticloadbalancingv2_loadbalancer.Properties.LoadBalancerAttributes exists <<[Advanced Monitoring] Load balancers must configure attributes>>

    some Properties.LoadBalancerAttributes[*] {
        Key == 'access_logs.s3.enabled'
        Value == 'true' <<[Advanced Monitoring] ALB/NLB must have access logging enabled>>
    }
}

# ============================================================================
# API Gateway Logging
# ============================================================================

# API Gateway access logging
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_apigateway_logging when %apigateway_stage !empty {

    %apigateway_stage.Properties.AccessLogSetting exists <<[Advanced Monitoring] API Gateway must have access logging configured>>
    %apigateway_stage.Properties.AccessLogSetting.DestinationArn exists <<[Advanced Monitoring] API Gateway access logging must specify destination>>
}

# API Gateway execution logging
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_apigateway_execution_logging when %apigateway_stage !empty {

    %apigateway_stage.Properties.MethodSettings exists <<[Advanced Monitoring] API Gateway stages must configure method settings>>
    %apigateway_stage.Properties.MethodSettings[*] {
        LoggingLevel exists <<[Advanced Monitoring] Method settings must specify logging level>>
        LoggingLevel in ['INFO', 'ERROR'] <<[Advanced Monitoring] API Gateway logging level must be INFO or ERROR>>
    }
}

# ============================================================================
# AWS Config Monitoring
# ============================================================================

# Config recorder enabled
# CloudForge Mapping: CONFIGURATION_MANAGEMENT control
rule advanced_monitoring_config_recorder when %config_configurationrecorder !empty {

    %config_configurationrecorder.Properties.RecordingGroup.AllSupported == true <<[Advanced Monitoring] AWS Config must record all supported resources>>
}

# Config delivery channel
# CloudForge Mapping: CONFIGURATION_MANAGEMENT control
rule advanced_monitoring_config_delivery when %config_deliverychannel !empty {

    %config_deliverychannel.Properties.S3BucketName exists <<[Advanced Monitoring] AWS Config must have delivery channel configured>>
}

# ============================================================================
# GuardDuty Monitoring
# ============================================================================

# GuardDuty enabled
# CloudForge Mapping: THREAT_DETECTION control
rule advanced_monitoring_guardduty_enabled when %guardduty_detector !empty {

    %guardduty_detector.Properties.Enable == true <<[Advanced Monitoring] GuardDuty must be enabled for threat monitoring>>
}

# ============================================================================
# CloudFront Logging
# ============================================================================

# CloudFront access logging
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_cloudfront_logging when %cloudfront_distribution !empty {

    when Properties.DistributionConfig.Logging exists {
        %cloudfront_distribution.Properties.DistributionConfig.Logging.Bucket exists <<[Advanced Monitoring] CloudFront logging must specify bucket>>
    }
}

# ============================================================================
# Redshift Logging
# ============================================================================

# Redshift audit logging
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_redshift_logging when %redshift_cluster !empty {

    %redshift_cluster.Properties.LoggingProperties exists <<[Advanced Monitoring] Redshift must have logging configured>>
    %redshift_cluster.Properties.LoggingProperties.BucketName exists <<[Advanced Monitoring] Redshift logging must specify bucket>>
}

# ============================================================================
# ECS Task Monitoring
# ============================================================================

# ECS task definition logging
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_ecs_logging when %ecs_taskdefinition !empty {

    %ecs_taskdefinition.Properties.ContainerDefinitions exists <<[Advanced Monitoring] ECS task definitions must define containers>>
    %ecs_taskdefinition.Properties.ContainerDefinitions[*] {
        LogConfiguration exists <<[Advanced Monitoring] ECS containers must have log configuration>>
        LogConfiguration.LogDriver exists <<[Advanced Monitoring] ECS container must have log driver configured>>
    }
}

# ============================================================================
# CloudTrail Advanced Features
# ============================================================================

# CloudTrail Insights enabled
# CloudForge Mapping: CLOUDTRAIL_INSIGHTS control
rule advanced_monitoring_cloudtrail_insights when %cloudtrail_trail !empty {

    %cloudtrail_trail.Properties.InsightSelectors exists <<[Advanced Monitoring] CloudTrail should enable Insights for anomaly detection>>
}

# CloudTrail Organization trail
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_cloudtrail_organization when %cloudtrail_trail !empty {

    %cloudtrail_trail.Properties.IsOrganizationTrail == true <<[Advanced Monitoring] Consider using Organization trails for centralized logging>>
}

# CloudTrail S3 data events
# CloudForge Mapping: AUDIT_LOGGING control
rule advanced_monitoring_cloudtrail_s3_data_events when %cloudtrail_trail !empty {

    %cloudtrail_trail.Properties.EventSelectors exists <<[Advanced Monitoring] CloudTrail should configure event selectors>>

    some Properties.EventSelectors[*] {
        DataResources exists <<[Advanced Monitoring] Event selectors should include data resources>>
        some DataResources[*] {
            Type == 'AWS::S3::Object' <<[Advanced Monitoring] CloudTrail should log S3 data events>>
        }
    }
}

# ============================================================================
# X-Ray Distributed Tracing
# ============================================================================

# X-Ray sampling rule
# CloudForge Mapping: MONITORING control
rule advanced_monitoring_xray_sampling when %xray_samplingrule !empty {

    %xray_samplingrule.Properties.SamplingRule exists <<[Advanced Monitoring] X-Ray must have sampling rule configured>>
    %xray_samplingrule.Properties.SamplingRule.RuleName exists <<[Advanced Monitoring] X-Ray sampling rule must have name>>
}

# ============================================================================
# CloudWatch Composite Alarms
# ============================================================================

# CloudWatch composite alarm configuration
# CloudForge Mapping: MONITORING control
rule advanced_monitoring_composite_alarm when %cloudwatch_compositealarm !empty {

    %cloudwatch_compositealarm.Properties.AlarmRule exists <<[Advanced Monitoring] Composite alarm must have alarm rule>>
    %cloudwatch_compositealarm.Properties.AlarmActions exists <<[Advanced Monitoring] Composite alarm must have actions configured>>
}

# ============================================================================
# CloudWatch Log Metric Filters
# ============================================================================

# CloudWatch metric filter for security events
# CloudForge Mapping: MONITORING control
rule advanced_monitoring_metric_filter when %logs_metricfilter !empty {

    %logs_metricfilter.Properties.FilterPattern exists <<[Advanced Monitoring] Metric filter must have filter pattern>>
    %logs_metricfilter.Properties.MetricTransformations exists <<[Advanced Monitoring] Metric filter must have transformations>>
}

# ============================================================================
# CloudWatch Dashboards
# ============================================================================

# CloudWatch dashboard with widgets
# CloudForge Mapping: MONITORING control
rule advanced_monitoring_dashboard when %cloudwatch_dashboard !empty {

    %cloudwatch_dashboard.Properties.DashboardBody exists <<[Advanced Monitoring] CloudWatch dashboard must have body configured>>
}
