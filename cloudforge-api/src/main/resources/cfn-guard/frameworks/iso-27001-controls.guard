# ISO 27001:2013 - Information Security Management System Controls
#
# CloudFormation Guard rules for ISO 27001 compliance validation
# Based on Annex A controls
#
# CloudForge Core - Multi-Layer Compliance Validation
# Layer 3: Template-Level Policy Enforcement (cfn-guard)


let s3_bucket = Resources.*[ Type == 'AWS::S3::Bucket' ]
let ec2_securitygroup = Resources.*[ Type == 'AWS::EC2::SecurityGroup' ]
let ec2_volume = Resources.*[ Type == 'AWS::EC2::Volume' ]
let rds_dbinstance = Resources.*[ Type == 'AWS::RDS::DBInstance' ]
let efs_filesystem = Resources.*[ Type == 'AWS::EFS::FileSystem' ]
let kms_key = Resources.*[ Type == 'AWS::KMS::Key' ]
let guardduty_detector = Resources.*[ Type == 'AWS::GuardDuty::Detector' ]
let cloudtrail_trail = Resources.*[ Type == 'AWS::CloudTrail::Trail' ]
let ec2_flowlog = Resources.*[ Type == 'AWS::EC2::FlowLog' ]
let elasticloadbalancingv2_listener = Resources.*[ Type == 'AWS::ElasticLoadBalancingV2::Listener' ]
let cloudfront_distribution = Resources.*[ Type == 'AWS::CloudFront::Distribution' ]
let logs_loggroup = Resources.*[ Type == 'AWS::Logs::LogGroup' ]
# ============================================================================
# A.8 - Asset Management
# ============================================================================

# A.8.2.3 - Handling of assets
# CloudForge Mapping: DATA_PROTECTION control
rule iso27001_s3_versioning when %s3_bucket !empty {

    %s3_bucket.Properties.VersioningConfiguration exists <<[ISO 27001 A.8.2.3] S3 buckets must have versioning configured>>
    %s3_bucket.Properties.VersioningConfiguration.Status == 'Enabled' <<[ISO 27001 A.8.2.3] S3 versioning should be enabled>>
}

# ============================================================================
# A.9 - Access Control
# ============================================================================

# A.9.1.2 - Access to networks and network services
# CloudForge Mapping: NETWORK_SECURITY control
rule iso27001_security_groups_restricted when %ec2_securitygroup !empty {

    when Properties.SecurityGroupIngress exists {
        %ec2_securitygroup.Properties.SecurityGroupIngress[*] {
            when CidrIp exists {
                CidrIp != '0.0.0.0/0' <<[ISO 27001 A.9.1.2] Security groups must not allow unrestricted access>>
            }
            when CidrIpv6 exists {
                CidrIpv6 != '::/0' <<[ISO 27001 A.9.1.2] Security groups must not allow unrestricted IPv6 access>>
            }
        }
    }
}

# A.9.4.1 - Information access restriction
# CloudForge Mapping: ACCESS_CONTROL control
rule iso27001_s3_public_access when %s3_bucket !empty {

    %s3_bucket.Properties.PublicAccessBlockConfiguration exists <<[ISO 27001 A.9.4.1] S3 must have public access block configured>>
    %s3_bucket.Properties.PublicAccessBlockConfiguration.BlockPublicAcls == true <<[ISO 27001 A.9.4.1] S3 must block public ACLs>>
    %s3_bucket.Properties.PublicAccessBlockConfiguration.BlockPublicPolicy == true <<[ISO 27001 A.9.4.1] S3 must block public policy>>
    %s3_bucket.Properties.PublicAccessBlockConfiguration.IgnorePublicAcls == true <<[ISO 27001 A.9.4.1] S3 must ignore public ACLs>>
    %s3_bucket.Properties.PublicAccessBlockConfiguration.RestrictPublicBuckets == true <<[ISO 27001 A.9.4.1] S3 must restrict public buckets>>
}

# ============================================================================
# A.10 - Cryptography
# ============================================================================

# A.10.1.1 - Policy on the use of cryptographic controls
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule iso27001_s3_encryption when %s3_bucket !empty {

    %s3_bucket.Properties.BucketEncryption exists <<[ISO 27001 A.10.1.1] S3 buckets must have encryption configured>>
    %s3_bucket.Properties.BucketEncryption.ServerSideEncryptionConfiguration exists <<[ISO 27001 A.10.1.1] S3 must configure server-side encryption>>

    %s3_bucket.Properties.BucketEncryption.ServerSideEncryptionConfiguration[*] {
        ServerSideEncryptionByDefault exists <<[ISO 27001 A.10.1.1] S3 encryption must specify default algorithm>>
        ServerSideEncryptionByDefault.SSEAlgorithm in ['AES256', 'aws:kms'] <<[ISO 27001 A.10.1.1] S3 must use AES256 or aws:kms>>
    }
}

# CloudForge Mapping: ENCRYPTION_AT_REST control
rule iso27001_ebs_encryption when %ec2_volume !empty {

    %ec2_volume.Properties.Encrypted == true <<[ISO 27001 A.10.1.1] EBS volumes must be encrypted>>
}

# CloudForge Mapping: ENCRYPTION_AT_REST control
rule iso27001_rds_encryption when %rds_dbinstance !empty {

    %rds_dbinstance.Properties.StorageEncrypted == true <<[ISO 27001 A.10.1.1] RDS instances must use encrypted storage>>
}

# CloudForge Mapping: ENCRYPTION_AT_REST control
rule iso27001_efs_encryption when %efs_filesystem !empty {

    %efs_filesystem.Properties.Encrypted == true <<[ISO 27001 A.10.1.1] EFS file systems must be encrypted>>
}

# A.10.1.2 - Key management
# CloudForge Mapping: KEY_MANAGEMENT control
rule iso27001_kms_rotation when %kms_key !empty {

    %kms_key.Properties.EnableKeyRotation == true <<[ISO 27001 A.10.1.2] KMS keys should have automatic rotation enabled>>
}

# ============================================================================
# A.12 - Operations Security
# ============================================================================

# A.12.2.1 - Controls against malware
# CloudForge Mapping: THREAT_DETECTION control
rule iso27001_guardduty_enabled when %guardduty_detector !empty {

    %guardduty_detector.Properties.Enable == true <<[ISO 27001 A.12.2.1] GuardDuty should be enabled for threat detection>>
}

# A.12.4.1 - Event logging
# CloudForge Mapping: AUDIT_LOGGING control
rule iso27001_cloudtrail_enabled when %cloudtrail_trail !empty {

    %cloudtrail_trail.Properties.IsLogging == true <<[ISO 27001 A.12.4.1] CloudTrail must be enabled>>
    %cloudtrail_trail.Properties.EnableLogFileValidation == true <<[ISO 27001 A.12.4.1] CloudTrail must enable log file validation>>
}

# A.12.4.2 - Protection of log information
# CloudForge Mapping: ENCRYPTION_AT_REST control
rule iso27001_cloudtrail_encryption when %cloudtrail_trail !empty {

    %cloudtrail_trail.Properties.KMSKeyId exists <<[ISO 27001 A.12.4.2] CloudTrail logs should be encrypted with KMS>>
}

# A.12.4.3 - Administrator and operator logs
# CloudForge Mapping: NETWORK_MONITORING control
rule iso27001_vpc_flow_logs when %ec2_flowlog !empty {

    %ec2_flowlog.Properties.ResourceType == 'VPC' <<[ISO 27001 A.12.4.3] VPC Flow Logs must target VPC>>
    %ec2_flowlog.Properties.TrafficType == 'ALL' <<[ISO 27001 A.12.4.3] VPC Flow Logs must capture ALL traffic>>
}

# ============================================================================
# A.13 - Communications Security
# ============================================================================

# A.13.1.1 - Network controls
# CloudForge Mapping: ENCRYPTION_IN_TRANSIT control
rule iso27001_alb_https when %elasticloadbalancingv2_listener !empty {

    %elasticloadbalancingv2_listener.Properties.Protocol in ['HTTPS', 'TLS'] <<[ISO 27001 A.13.1.1] ALB listeners must use HTTPS/TLS>>
    %elasticloadbalancingv2_listener.Properties.Certificates exists <<[ISO 27001 A.13.1.1] ALB listeners must have certificates configured>>
}

# A.13.2.3 - Electronic messaging
# CloudForge Mapping: ENCRYPTION_IN_TRANSIT control
rule iso27001_cloudfront_https when %cloudfront_distribution !empty {

    %cloudfront_distribution.Properties.DistributionConfig.ViewerCertificate exists <<[ISO 27001 A.13.2.3] CloudFront must have viewer certificate configured>>
    %cloudfront_distribution.Properties.DistributionConfig.ViewerCertificate.MinimumProtocolVersion in ['TLSv1.2_2021', 'TLSv1.2_2019', 'TLSv1.2_2018'] <<[ISO 27001 A.13.2.3] CloudFront must use TLS 1.2+>>
}

# ============================================================================
# A.17 - Information Security Aspects of Business Continuity Management
# ============================================================================

# A.17.1.2 - Implementing information security continuity
# CloudForge Mapping: BACKUP_RECOVERY control
rule iso27001_rds_backup when %rds_dbinstance !empty {

    %rds_dbinstance.Properties.BackupRetentionPeriod exists <<[ISO 27001 A.17.1.2] RDS must have backup retention configured>>
    %rds_dbinstance.Properties.BackupRetentionPeriod >= 7 <<[ISO 27001 A.17.1.2] RDS backups must be retained for at least 7 days>>
}

# A.17.2.1 - Availability of information processing facilities
# CloudForge Mapping: HIGH_AVAILABILITY control
rule iso27001_rds_multi_az when %rds_dbinstance !empty {

    %rds_dbinstance.Properties.MultiAZ == true <<[ISO 27001 A.17.2.1] RDS instances should use Multi-AZ for high availability>>
}

# ============================================================================
# A.18 - Compliance
# ============================================================================

# A.18.1.3 - Protection of records
# CloudForge Mapping: AUDIT_LOGGING control
rule iso27001_cloudwatch_log_retention when %logs_loggroup !empty {

    %logs_loggroup.Properties.RetentionInDays exists <<[ISO 27001 A.18.1.3] CloudWatch logs must have retention configured>>
    %logs_loggroup.Properties.RetentionInDays >= 90 <<[ISO 27001 A.18.1.3] CloudWatch logs must retain for at least 90 days>>
}
