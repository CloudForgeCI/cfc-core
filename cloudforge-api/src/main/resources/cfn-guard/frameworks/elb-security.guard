# ELB Security - Cross-Framework Security Control
#
# CloudFormation Guard rules for Elastic Load Balancer validation
# Applies across all compliance frameworks (HIPAA, PCI-DSS, SOC2, GDPR, ISO 27001, etc.)
#
# CloudForge Core - Multi-Layer Compliance Validation
# Layer 3: Template-Level Policy Enforcement (cfn-guard)

# ============================================================================
# Application/Network Load Balancer Security
# ============================================================================

# ALB/NLB access logging
# CloudForge Mapping: AUDIT_LOGGING control
rule elb_security_alb_access_logging when
    resourceType == 'AWS::ElasticLoadBalancingV2::LoadBalancer' {

    Properties.LoadBalancerAttributes exists <<[ELB Security] Load balancers must configure attributes>>

    some Properties.LoadBalancerAttributes[*] {
        Key == 'access_logs.s3.enabled'
        Value == 'true' <<[ELB Security] Application and Network Load Balancers must have access logging enabled>>
    }
}

# ALB deletion protection
# CloudForge Mapping: DELETION_PROTECTION control
rule elb_security_alb_deletion_protection when
    resourceType == 'AWS::ElasticLoadBalancingV2::LoadBalancer' {

    Properties.LoadBalancerAttributes exists <<[ELB Security] Load balancers must configure attributes>>

    some Properties.LoadBalancerAttributes[*] {
        Key == 'deletion_protection.enabled'
        Value == 'true' <<[ELB Security] Application and Network Load Balancers must have deletion protection enabled>>
    }
}

# ALB drop invalid HTTP headers
# CloudForge Mapping: WEB_APPLICATION_FIREWALL control
rule elb_security_alb_drop_http_headers when
    resourceType == 'AWS::ElasticLoadBalancingV2::LoadBalancer' {

    when Properties.Type == 'application' OR Properties.Type not exists {
        when Properties.LoadBalancerAttributes exists {
            some Properties.LoadBalancerAttributes[*] {
                Key == 'routing.http.drop_invalid_header_fields.enabled'
                Value == 'true' <<[ELB Security] Application Load Balancers should drop invalid HTTP headers>>
            }
        }
    }
}

# ALB/NLB cross-zone load balancing
# CloudForge Mapping: HIGH_AVAILABILITY control
rule elb_security_cross_zone_load_balancing when
    resourceType == 'AWS::ElasticLoadBalancingV2::LoadBalancer' {

    when Properties.Type in ['network', 'gateway'] {
        when Properties.LoadBalancerAttributes exists {
            some Properties.LoadBalancerAttributes[*] {
                Key == 'load_balancing.cross_zone.enabled'
                Value == 'true' <<[ELB Security] Network and Gateway Load Balancers should enable cross-zone load balancing>>
            }
        }
    }
}

# ALB internal for internal services
# CloudForge Mapping: NETWORK_SECURITY control
rule elb_security_alb_internal_scheme when
    resourceType == 'AWS::ElasticLoadBalancingV2::LoadBalancer' {

    Properties.Scheme exists <<[ELB Security] Load balancer scheme should be explicitly specified>>
}

# ALB WAF integration
# CloudForge Mapping: WEB_APPLICATION_FIREWALL control
rule elb_security_alb_waf when
    resourceType == 'AWS::WAFv2::WebACLAssociation' {

    Properties.ResourceArn exists <<[ELB Security] Application Load Balancers should be associated with WAF>>
}

# ============================================================================
# Load Balancer Listener Security
# ============================================================================

# ALB/NLB HTTPS/TLS listener
# CloudForge Mapping: ENCRYPTION_IN_TRANSIT control
rule elb_security_listener_https when
    resourceType == 'AWS::ElasticLoadBalancingV2::Listener' {

    Properties.Protocol in ['HTTPS', 'TLS', 'HTTP'] <<[ELB Security] Load balancer listener protocol must be specified>>

    when Properties.Protocol == 'HTTP' {
        some Properties.DefaultActions[*] {
            Type == 'redirect' <<[ELB Security] HTTP listeners must redirect to HTTPS>>
        }
    }
}

# ALB/NLB listener certificate
# CloudForge Mapping: CERTIFICATE_MANAGEMENT control
rule elb_security_listener_certificate when
    resourceType == 'AWS::ElasticLoadBalancingV2::Listener' {

    when Properties.Protocol in ['HTTPS', 'TLS'] {
        Properties.Certificates exists <<[ELB Security] HTTPS/TLS listeners must have certificates configured>>
        Properties.Certificates not empty <<[ELB Security] HTTPS/TLS listeners must have at least one certificate>>
    }
}

# ALB listener SSL policy
# CloudForge Mapping: ENCRYPTION_IN_TRANSIT control
rule elb_security_listener_ssl_policy when
    resourceType == 'AWS::ElasticLoadBalancingV2::Listener' {

    when Properties.Protocol in ['HTTPS', 'TLS'] {
        Properties.SslPolicy exists <<[ELB Security] HTTPS/TLS listeners must specify SSL policy>>
        Properties.SslPolicy in [
            'ELBSecurityPolicy-TLS13-1-2-2021-06',
            'ELBSecurityPolicy-TLS13-1-2-Res-2021-06',
            'ELBSecurityPolicy-TLS-1-2-2017-01',
            'ELBSecurityPolicy-TLS-1-2-Ext-2018-06',
            'ELBSecurityPolicy-FS-1-2-2019-08',
            'ELBSecurityPolicy-FS-1-2-Res-2019-08',
            'ELBSecurityPolicy-FS-1-2-Res-2020-10'
        ] <<[ELB Security] HTTPS/TLS listeners should use TLS 1.2+ SSL policies>>
    }
}

# ============================================================================
# Target Group Security
# ============================================================================

# Target group health check
# CloudForge Mapping: HIGH_AVAILABILITY control
rule elb_security_target_group_health_check when
    resourceType == 'AWS::ElasticLoadBalancingV2::TargetGroup' {

    Properties.HealthCheckEnabled == true OR Properties.HealthCheckEnabled not exists
    Properties.HealthCheckPath exists OR Properties.HealthCheckPort exists <<[ELB Security] Target groups must have health checks configured>>
}

# Target group deregistration delay
# CloudForge Mapping: HIGH_AVAILABILITY control
rule elb_security_target_group_deregistration when
    resourceType == 'AWS::ElasticLoadBalancingV2::TargetGroup' {

    when Properties.TargetGroupAttributes exists {
        some Properties.TargetGroupAttributes[*] {
            Key == 'deregistration_delay.timeout_seconds' <<[ELB Security] Target groups should configure deregistration delay>>
        }
    }
}

# ============================================================================
# Classic Load Balancer Security (Legacy)
# ============================================================================

# Classic ELB access logging
# CloudForge Mapping: AUDIT_LOGGING control
rule elb_security_classic_access_logging when
    resourceType == 'AWS::ElasticLoadBalancing::LoadBalancer' {

    Properties.AccessLoggingPolicy exists <<[ELB Security] Classic Load Balancers must have access logging policy>>
    Properties.AccessLoggingPolicy.Enabled == true <<[ELB Security] Classic Load Balancers must enable access logging>>
    Properties.AccessLoggingPolicy.S3BucketName exists <<[ELB Security] Classic Load Balancer logging must specify S3 bucket>>
}

# Classic ELB not internet-facing
# CloudForge Mapping: NETWORK_SECURITY control
rule elb_security_classic_not_public when
    resourceType == 'AWS::ElasticLoadBalancing::LoadBalancer' {

    Properties.Scheme != 'internet-facing' <<[ELB Security] Classic Load Balancers should not be internet-facing>>
}

# Classic ELB SSL certificate
# CloudForge Mapping: CERTIFICATE_MANAGEMENT control
rule elb_security_classic_ssl_certificate when
    resourceType == 'AWS::ElasticLoadBalancing::LoadBalancer' {

    when Properties.Listeners exists {
        Properties.Listeners[*] {
            when Protocol in ['HTTPS', 'SSL'] {
                SSLCertificateId exists <<[ELB Security] Classic Load Balancer HTTPS/SSL listeners must have certificates>>
            }
        }
    }
}

# Classic ELB connection draining
# CloudForge Mapping: HIGH_AVAILABILITY control
rule elb_security_classic_connection_draining when
    resourceType == 'AWS::ElasticLoadBalancing::LoadBalancer' {

    Properties.ConnectionDrainingPolicy exists <<[ELB Security] Classic Load Balancers should have connection draining policy>>
    Properties.ConnectionDrainingPolicy.Enabled == true <<[ELB Security] Classic Load Balancers should enable connection draining>>
}

# Classic ELB cross-zone load balancing
# CloudForge Mapping: HIGH_AVAILABILITY control
rule elb_security_classic_cross_zone when
    resourceType == 'AWS::ElasticLoadBalancing::LoadBalancer' {

    Properties.CrossZone == true <<[ELB Security] Classic Load Balancers should enable cross-zone load balancing>>
}

# ============================================================================
# Load Balancer Listener Rules
# ============================================================================

# Listener rule with conditions
# CloudForge Mapping: NETWORK_SECURITY control
rule elb_security_listener_rule_conditions when
    resourceType == 'AWS::ElasticLoadBalancingV2::ListenerRule' {

    Properties.Conditions exists <<[ELB Security] Listener rules must have conditions specified>>
    Properties.Conditions not empty <<[ELB Security] Listener rules must have at least one condition>>
}
