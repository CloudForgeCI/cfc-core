{
  "stackName": "Metabase-Stack",
  "applicationId": "metabase",
  "applicationName": "Metabase",
  "description": "LocalStack Metabase with PostgreSQL companion and full compliance controls",
  "environment": "production",
  "runtime": "FARGATE",
  "securityProfile": "PRODUCTION",
  "topology": "APPLICATION_SERVICE",
  "networkMode": "private-with-nat",
  "region": "us-east-1",
  "authMode": "none",
  "complianceFrameworks": "PCI-DSS,HIPAA,SOC2,GDPR",
  "complianceMode": "ADVISORY",
  "awsConfigEnabled": true,
  "guardDutyEnabled": true,
  "auditManagerEnabled": true,
  "wafEnabled": true,
  "macieEnabled": true,
  "macieAutomatedDiscovery": true,
  "enableSsl": true,
  "provisionDatabase": true,
  "cpu": 1024,
  "memory": 2048,
  "minInstanceCapacity": 1,
  "maxInstanceCapacity": 1,
  "databaseMultiAz": true
}
