<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.cloudforgeci</groupId>
    <artifactId>cfc-core</artifactId>
    <version>3.2.3-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!-- Real cfc-core reactor member (built/published alongside cloudforge-core/cloudforge-api,
       not a standalone consumer like cfc-testing), so it's a real, resolvable Central artifact
       in CI rather than only existing in whichever machine happened to `mvn install` it locally.
       Thin HTTP wrapper around CloudForgeSynthesizer, the one door into jsii/AWS-CDK synthesis
       in cloudforge-manager's deploy pipeline. Runs as a same-task sidecar container next to a
       native-image-compiled cloudforge-manager, which no longer links against jsii at all. No
       proprietary content of its own, public like every other module here, despite existing
       only for cloudforge-manager's benefit, since it's a plain wrapper around already-public
       cloudforge-api code with nothing CloudForge-specific to protect. -->
  <artifactId>cloudforge-synth-service</artifactId>
  <version>3.2.3-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>CloudForge Synth Service</name>
  <description>
    Thin HTTP wrapper around CloudForgeSynthesizer (cloudforge-api) -- the one door into
    jsii/AWS-CDK synthesis. Runs as a same-task sidecar container next to a native-image-compiled
    cloudforge-manager, which no longer links against jsii at all.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.cloudforgeci</groupId>
      <artifactId>cloudforge-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.cloudforgeci.synthservice.SynthServiceMain</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- Same shape cfc-testing/InteractiveDeployer already runs with: `java -cp target/classes:
           target/dependency/* MainClass`, no shade plugin needed for a single-jar-plus-libs
           sidecar image. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
