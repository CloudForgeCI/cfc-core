{
  "description": "Production environment with SOC 2 compliance - recommended for most organizations",
  "stackName": "CloudForge-Prod-SOC2",
  "runtime": "ec2",
  "topology": "jenkins-service",
  "securityProfile": "production",
  "region": "us-east-1",

  "domain": "example.com",
  "subdomain": "jenkins",
  "enableSsl": true,
  "createZone": false,
  "_domain_note": "Domain is optional - remove domain/subdomain/createZone for Private CA (meets SOC2 encryption requirements)",

  "networkMode": "private-with-nat",
  "wafEnabled": true,
  "authMode": "alb-oidc",
  "cognitoAutoProvision": true,
  "cognitoDomainPrefix": "cloudforge-prod",
  "cognitoMfaEnabled": true,
  "cognitoMfaMethod": "totp",

  "awsConfigEnabled": true,
  "createConfigInfrastructure": true,
  "complianceFrameworks": "SOC2",
  "scopeConfigRulesToDeployment": false,
  "enableS3VersioningRemediation": true,
  "enableCloudTrailLoggingRemediation": true,
  "complianceMode": "enforce",

  "guardDutyEnabled": true,
  "guardDutyAlertsConfigured": true,
  "auditManagerEnabled": true,

  "logRetentionDays": 730,
  "albAccessLogging": true,
  "enableFlowlogs": true,

  "instanceType": "t3.medium",
  "minInstanceCapacity": 2,
  "maxInstanceCapacity": 6,
  "enableAutoScaling": true,
  "cpuTargetUtilization": 60,

  "healthCheckGracePeriod": 300,
  "healthCheckInterval": 30,
  "healthCheckTimeout": 5,
  "healthyThreshold": 2,
  "unhealthyThreshold": 3,

  "enableMonitoring": true,
  "enableEncryption": true,
  "retainStorage": true,
  "certificateExpirationMonitoring": true
}
