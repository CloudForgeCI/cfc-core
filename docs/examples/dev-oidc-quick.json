{
  "stackName": "CloudForge-Dev-OIDC",
  "applicationId": "jenkins",
  "runtime": "fargate",
  "topology": "jenkins-service",
  "securityProfile": "dev",
  "region": "us-east-1",

  "networkMode": "private-with-nat",
  "wafEnabled": false,

  "authMode": "alb-oidc",
  "enableSsl": true,
  "cognitoAutoProvision": true,
  "cognitoDomainPrefix": "cloudforge-dev-quick",
  "cognitoMfaEnabled": false,

  "awsConfigEnabled": false,
  "guardDutyEnabled": false,
  "logRetentionDays": 30,

  "minInstanceCapacity": 1,
  "maxInstanceCapacity": 1,
  "enableAutoScaling": false,

  "enableMonitoring": true,
  "enableEncryption": true,
  "retainStorage": false
}
